rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Armazenamento de Assinaturas (pasta assinaturas)
    match /assinaturas/{fileName=**} {
      // Criação (create/upload): Permitida com validação estrita (apenas imagens e tamanho máximo de 2MB)
      allow create: if request.resource.size <= 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');

      // Leitura (read), Atualização (update) e Exclusão (delete): Totalmente bloqueadas publicamente.
      // Apenas o pesquisador/administrador terá acesso através do console do Firebase.
      allow read, update, delete: if false;
    }

    // Bloqueio geral para qualquer outro caminho não autorizado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
